node_modules

.env
.env.local
# LOCAL preview credentials (APP_ENV=preview + the scratch database URL), written
# by scripts/preview-env.sh into the working tree. Deliberately NOT `.env.local`:
# Bun auto-loads that into every `bun` process in this directory, which would
# hand preview mode to the published server. Never commit it.
/.preview-env
# Written by scripts/sync-shared-site.sh into the WORKING tree only (there is no
# git there); read by /preview-status for branch + commit. Never commit it.
.preview-deployment.json
.DS_Store
.cache
.output
.nitro
.tanstack

/dist/
/dist-ssr/

# Vercel Build Output API bundle (produced by build-vercel.sh at go-live).
/.vercel/

# Runtime server log written on start.
/.run/

# Generated by the TanStack Start router plugin on dev/build.
src/routeTree.gen.ts
