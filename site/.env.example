# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit a real .env — .env is gitignored.
#
# Every variable below is read at runtime from process.env.
# Names only are documented here; values stay local to the operator.

# Deployment mode — "production" | "preview". This is the ONLY switch that
# decides which database the app uses (never presence of PREVIEW_DATABASE_URL).
#   • production (or unset / any other value): DATABASE_URL is used, and
#     PREVIEW_DATABASE_URL is ignored even if accidentally set.
#   • preview: PREVIEW_DATABASE_URL is used (and REQUIRED — fail-closed if unset).
APP_ENV=production

# Postgres connection string (Neon, Supabase, or any Postgres). Used in
# production (and local dev / any non-"preview" APP_ENV).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# PREVIEW ONLY — disposable scratch database for the preview/working-site
# environment (see docs/PREVIEW_ENVIRONMENT.md). It is read ONLY when
# APP_ENV=preview. Set it ONLY on the preview deployment, NEVER on the live
# deployment.
PREVIEW_DATABASE_URL=postgresql://user:password@preview-host:5432/preview_scratch?sslmode=require

# HTTP port the server listens on (default 3000).
PORT=3000

# Stripe webhook signing secret (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Stripe secret API key (sk_live_...). NOTE: checkout.ts reads this
# under the intentionally-misspelled name `secertkey` — keep it exact.
secertkey=sk_live_xxxxxxxxxxxxxxxx

# Used by go-live.sh / publish.sh to deploy to Vercel.
VERCEL_TOKEN=